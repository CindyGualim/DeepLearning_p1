# Datos generados (se reproducen con la semilla, no se versionan)
datos/*
!datos/.gitkeep

# Figuras regeneradas por el notebook
figuras/*
!figuras/.gitkeep

# Artefactos: SI se versionan los pesos del modelo candidato (entregable).
# Se ignoran solo los checkpoints intermedios.
artefactos/checkpoints/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# Sistema
.DS_Store
Thumbs.db

# Registro de uso: la base SQLite es estado de ejecucion y cambia en cada arranque.
# Lo que se versiona como evidencia es el volcado (scripts/exportar_registros.py).
datos_demo/registro.db

# Entorno local del servicio
.pytest_cache/

# Capturas del servicio en produccion: SI se versionan, son evidencia de la rubrica.
# (Hay que reincluir el directorio antes que su contenido: `figuras/*` impide que git
#  descienda a el.)
!figuras/evidencias/
!figuras/evidencias/**
